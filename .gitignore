# ============================================================
# PRIVACY PROTECTION - Files that may contain note titles/paths
# ============================================================

# Session state (contains full file paths with note titles!)
recentf
recentf~
places
bookmarks
bookmarks~
saveplace
ido.last
savehist
history

# Desktop sessions (complete session state - all open files!)
desktop/
*.desktop
*.desktop.lock
.emacs.desktop
.emacs.desktop.lock

# Org-mode (may contain note locations and titles)
.org-id-locations
.org-clock-save
.org-clock-save.el
org-clock-save.el
org-roam.db
org-roam.db-shm
org-roam.db-wal

# Project/completion caches (file paths)
projectile-bookmarks.eld
projectile.cache
smex-items

# ============================================================
# TYPING ANALYTICS DATA - Privacy sensitive keystroke data
# ============================================================

# Character-level typing data (timestamps + keystrokes)
keys

# Command frequency statistics
.emacs.keyfreq

# ============================================================
# SYNCTHING - Never commit these!
# ============================================================

.stversions/
*.sync-conflict-*
*sync-conflict*

# Per-device folder marker; carrying it in the repo confuses Syncthing
# when the config is cloned onto another machine.
.stfolder/

# ============================================================
# INSTALLED PACKAGES - Auto-downloaded, don't version
# ============================================================

elpa/
elpa.backup/
elpaca/
straight/
quelpa/
eln-cache/

# ============================================================
# CACHE AND TEMPORARY FILES
# ============================================================

auto-save-list/
transient/
url/
eshell/
network-security.data

# Undo history
# undo-fu-session stores the ACTUAL TEXT of edited buffers, including
# notes -- never commit it.
undo-fu-session/
undo-tree-history/
.undo-tree-*

# Compiled files
*.elc

# ============================================================
# BACKUP AND AUTOSAVE FILES
# ============================================================

# Emacs backups
*~
\#*\#
.\#*
*.backup
*.backup.*
.backups/
.autosaves/
# Without the leading dot: my-emacs-backups / my-emacs-autosaves in
# 00-core.el point here, and these hold full copies of files from
# outside the repo (notes, ~/Documents, ...).
backups/
autosaves/

# Version backups
init.el_v*.txt

# ============================================================
# SYSTEM FILES
# ============================================================

.DS_Store
Thumbs.db

# ============================================================
# TUTORIAL (not needed in git)
# ============================================================

tutorial/

# ============================================================
# SESSION COOKIES AND AUTHENTICATION TOKENS
# ============================================================

# curl/request.el cookie jar (may contain session tokens!)
request/curl-cookie-jar
curl-cookie-jar

# ============================================================
# PER-MACHINE STATE AND READING/CONNECTION HISTORY
# ============================================================

# TRAMP connection history: remote hostnames and paths
tramp

# ELisp REPL history
ielm-history.eld

# nov.el reading positions: reveals which books are being read
nov-places

logs/
games/

# ============================================================
# NOTE ON THE NEGATION PATTERNS THAT USED TO BE HERE
# ============================================================
# This file previously ended with:
#
#     !init.el
#     !early-init.el
#     !modules/
#     ...
#
# under the heading "keep only configuration files". Those lines had
# no effect. A negation pattern only re-includes a path that an
# EARLIER pattern excluded, and nothing here excludes them -- there is
# no catch-all "*". They therefore did not restrict tracking to config
# files; anything not matched above was, and is, tracked.
#
# Switching to a deny-by-default policy would be the stricter design:
#
#     *
#     !*/
#     !init.el
#     !early-init.el
#     !modules/**.el
#     !.gitignore
#     !README.md
#
# That is deliberately NOT enabled here, because it would silently
# stop tracking files that are currently committed on purpose
# (custom.el, function_helper.org, CHANGELOG.md, templates/). Switch
# only after auditing `git ls-files` and adding the wanted paths back.
