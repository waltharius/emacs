#!/usr/bin/env bash
# Every check of this configuration: what a commit checks (hooks/pre-commit:
# parens and lint) and every test in tests/.  For after `git am', which
# runs no pre-commit hook, and for continuous integration.
#
#     bash hooks/check-all            # everything
#     bash hooks/check-all loader     # only tests/test-loader.el (any part of a name)
#
# Each test file runs in its own `emacs -Q --batch', with the packages
# installed for this user (~/.emacs.d/elpa/) and nothing installed.
# Tests that load modules do so in a sandbox (tests/helper.el): the real
# notes, settings and ~/.emacs.d are neither read nor written.
#
# A file that fails prints ERT's report of what went wrong.  The exit
# status is 0 only when everything selected ran and passed:
#   - a name that selects no test file fails (a typo is not a pass);
#   - a test file that runs no test fails;
#   - skipped tests are counted and named in the last line; with
#     MYPKS_STRICT_TESTS=1 (set by the workflow, where every package
#     the tests need is installed) a skipped test fails the run.
# Locally a skip stays a skip: a missing package or program is reported,
# not hidden, and not counted as a failure of the code.

set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || dirname "$(dirname "$(readlink -f "$0")")")"
cd "$root" || exit 1

only="${1:-}"
strict="${MYPKS_STRICT_TESTS:-}"
# A time limit per test file, so that a test caught in a loop fails the
# run instead of hanging it (MYPKS_TEST_TIMEOUT seconds, 600 by default;
# without coreutils' timeout there is no limit).
seconds="${MYPKS_TEST_TIMEOUT:-600}"
limit=""
if command -v timeout >/dev/null 2>&1; then
  limit="timeout $seconds"
fi
status=0
files_run=0
skipped_total=0

if [ -z "$only" ]; then
  echo "checks:"
  if command -v emacs >/dev/null 2>&1; then
    emacs -Q --batch -l hooks/parens.el 2>&1 || status=1
  else
    echo "  FAILED   parens (no emacs on PATH)"
    status=1
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -B hooks/lint.py || status=1
    # The checkers' own tests (tests/hooks/test_*.py, unittest): what
    # the checks above report is only as good as what they recognise.
    output="$(python3 -B -m unittest discover -s tests/hooks -p 'test_*.py' 2>&1)"
    code=$?
    summary="$(grep -E '^Ran ' <<<"$output")"
    if [ "$code" -eq 0 ]; then
      printf '  ok       %-12s %s\n' "hook tests" "$summary"
    else
      status=1
      printf '  FAILED   %-12s %s\n' "hook tests" "$summary"
      grep -E -A12 '^(FAIL|ERROR):' <<<"$output" | sed 's/^/           /'
    fi
  else
    echo "  FAILED   lint (no python3 on PATH)"
    status=1
  fi
  echo
fi

echo "tests:"
for file in tests/test-*.el; do
  name="$(basename "$file" .el)"
  case "$name" in *"$only"*) ;; *) continue ;; esac
  files_run=$((files_run + 1))
  output="$($limit emacs -Q --batch --eval '(package-initialize)' -l ert -l "$file" \
              -f ert-run-tests-batch-and-exit 2>&1 </dev/null)"
  code=$?
  # 124: stopped by timeout -- a test looping, or waiting for an answer
  # (stdin is /dev/null, so a question gets none).
  if [ "$code" -eq 124 ] && [ -n "$limit" ]; then
    status=1
    printf '  FAILED   %-28s %s\n' "$name" "timed out after $seconds s: a test loops or waits"
    continue
  fi
  summary="$(grep -E '^Ran ' <<<"$output" | sed -E 's/ \(20[0-9-]+ .*\)$//')"
  ran="$(sed -nE 's/^Ran ([0-9]+) tests?.*/\1/p' <<<"$summary")"
  skipped="$(sed -nE 's/.* ([0-9]+) skipped.*/\1/p' <<<"$summary")"
  skipped="${skipped:-0}"
  skipped_total=$((skipped_total + skipped))
  if [ "$code" -eq 0 ] && [ "${ran:-0}" -eq 0 ]; then
    status=1
    printf '  FAILED   %-28s %s\n' "$name" "no test ran: the file defines none, or none loaded"
  elif [ "$code" -eq 0 ] && [ -n "$strict" ] && [ "$skipped" -gt 0 ]; then
    status=1
    printf '  FAILED   %-28s %s\n' "$name" "$summary -- skipped in a strict run:"
    grep -E '^ *SKIPPED ' <<<"$output" | sed 's/^ */           /'
    grep -E -A2 '^Test .* skipped' <<<"$output" | sed 's/^/           /'
  elif [ "$code" -eq 0 ]; then
    printf '  ok       %-28s %s\n' "$name" "$summary"
  else
    status=1
    printf '  FAILED   %-28s %s\n' "$name" "${summary:-did not run to the end}"
    # The reasons: ERT's condition blocks; when the file did not even
    # load, the error lines it printed (a missing package says "Cannot
    # load <package>"), else its last lines.
    if grep -qE '^Test .* condition:' <<<"$output"; then
      grep -E -A8 '^Test .* condition:' <<<"$output" | sed 's/^/           /'
    elif grep -qE '^Error|Cannot load|^Symbol.s|^Wrong|^Opening|^Searching' <<<"$output"; then
      grep -E '^Error|Cannot load|^Symbol.s|^Wrong|^Opening|^Searching' <<<"$output" \
        | head -n 8 | sed 's/^/           /'
    else
      tail -n 15 <<<"$output" | sed 's/^/           /'
    fi
  fi
done

if [ "$files_run" -eq 0 ]; then
  status=1
  echo "  FAILED   no test file name contains \"$only\""
fi

echo
if [ "$status" -ne 0 ]; then
  echo "result: FAILED"
elif [ "$skipped_total" -gt 0 ]; then
  echo "result: passed, $skipped_total test(s) skipped -- not everything was checked"
else
  echo "result: passed, nothing skipped"
fi

exit "$status"
